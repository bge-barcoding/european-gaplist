# Copy this file to ".env" (in the same folder) and fill in your details.
# ".env" is never uploaded to GitHub, so your password stays on this machine.

# Your GBIF account, needed to request occurrence downloads.
# Register for free at https://www.gbif.org if you do not have one.
GBIF_USER=
GBIF_PASSWORD=
GBIF_EMAIL=

# Only needed for the very last step (updating the live target list).
# Ask the target list administrator for these.
TARGETLIST_DB_HOST=
TARGETLIST_DB_NAME=
TARGETLIST_DB_USER=
TARGETLIST_DB_PASSWORD=
